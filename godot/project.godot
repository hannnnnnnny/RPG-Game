; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format documentation:
; https://docs.godotengine.org/en/stable/tutorials/scripting/godot_project.html

config_version=5

[application]

config/name="TidesOfKhah"
config/description="《潮蚀之环》—— 2D 暗黑克苏鲁 ARPG"
run/main_scene="res://scenes/main/MainGame.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Types="*res://scripts/core/types.gd"
AidlcRules="*res://scripts/core/aidlc_rules.gd"
LootGenerator="*res://scripts/core/loot_generator.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/custom_font="res://assets/fonts/zpix.ttf"

